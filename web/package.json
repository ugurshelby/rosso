{
  "name": "rosso-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3847",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start -p 3847",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "kur": "node scripts/kur.mjs",
    "test": "vitest run",
