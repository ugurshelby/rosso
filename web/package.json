    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.20.0",
    "motion": "^12.40.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.2",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
